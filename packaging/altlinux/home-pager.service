[Unit]
Description=Home Pager configuration editor for Homepage
After=network.target

[Service]
Type=simple
User=home-pager
Group=home-pager
WorkingDirectory=/var/lib/home-pager
ExecStart=/usr/bin/home-pager -conf /etc/home-pager/home-pager.yaml
Restart=on-failure
RestartSec=3
UMask=0027
StateDirectory=home-pager
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/home-pager

[Install]
WantedBy=multi-user.target
